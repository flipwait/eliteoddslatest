{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/kalshi-games", "destination": "/api/venues?v=kalshi" },
    { "source": "/api/novig-games", "destination": "/api/venues?v=novig" },
    { "source": "/api/potd", "destination": "/api/misc?action=potd" },
    { "source": "/api/discord", "destination": "/api/misc?action=discord" },
    { "source": "/api/combo", "destination": "/api/misc?action=combo" },
    { "source": "/api/feed", "destination": "/api/misc?action=feed" },
    { "source": "/api/placed", "destination": "/api/misc?action=placed" },
    { "source": "/api/settle-ml", "destination": "/api/misc?action=settle-ml" },
    { "source": "/api/tools", "destination": "/api/misc?action=tools" }
  ]
}
